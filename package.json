{
  "name": "wow-api",
  "private": true,
  "description": "WoW APIs consumer web app",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "Alban Nurkollari",
  "contributors": [
    {
      "name": "Alban Nurkollari",
      "email": "albannurkollari@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albannurkollari/wow-api.git"
  },
  "bugs": {
    "url": "https://github.com/albannurkollari/wow-api/issues"
  },
  "homepage": "https://github.com/albannurkollari/wow-api#readme",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "nodeTS": "node",
    "nodeTS:debug": "node --inspect-brk",
    "setClientAccessToken": "pnpm nodeTS scripts/wow-client-token.ts",
    "query": "pnpm nodeTS scripts/wow-queries.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "change-case": "^5.4.4",
    "dotenv": "^18.0.10",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
